{
	"name": "alias-imports",
	"version": "0.0.0-semantic-release",
	"description": "Create bare aliases in the imports map in package.json",
	"keywords": [
		"nodejs",
		"alias",
		"imports"
	],
	"license": "MIT",
	"repository": "privatenumber/alias-imports",
	"funding": "https://github.com/privatenumber/alias-imports?sponsor=1",
	"author": {
		"name": "Hiroki Osame",
		"email": "hiroki.osame@gmail.com"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.mjs",
	"exports": {
		".": "./dist/index.mjs",
		"./loader": "./dist/loader.mjs",
		"./require": "./dist/require.cjs"
	},
	"imports": {
		"#alias-imports": {
			"types": "./src/index.ts",
			"development": "./src/index.ts",
			"default": "./dist/index.mjs"
		}
	},
	"packageManager": "pnpm@9.4.0",
	"scripts": {
		"build": "pkgroll --target=node12.20 --minify",
		"lint": "lintroll --cache",
		"type-check": "tsc",
		"test": "pnpm build && node tests/index.ts",
		"dev": "node --watch --conditions=development tests/index.ts",
		"prepack": "pnpm build && clean-pkg-json"
	},
	"dependencies": {
		"get-conditions": "^1.0.1"
	},
	"devDependencies": {
		"@types/node": "^18.11.11",
		"clean-pkg-json": "^1.2.0",
		"execa": "^6.1.0",
		"fs-fixture": "^1.2.0",
		"kolorist": "^1.6.0",
		"lintroll": "^1.29.1",
		"manten": "2.0.0-beta.2",
		"pkgroll": "^1.7.0",
		"resolve-pkg-maps": "^1.0.0",
		"typescript": "^5.9.3"
	}
}
